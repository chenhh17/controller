[Unit]
Description=chenhh17 controller API
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/controller/backend
Environment=PYTHONPATH=%h/controller/backend
ExecStart=%h/controller/backend/.venv/bin/gunicorn -b 127.0.0.1:9000 -w 1 --threads 2 wsgi:app
Restart=always
RestartSec=3
MemoryMax=180M

[Install]
WantedBy=default.target
